---
// Layout for ARIES Next (/next/). Dark first, its own stylesheet; content comes from the same data files as v1.
// As in v1, Thai exists for Home and Contact only: in the Thai menu the other pages link to English and carry an EN tag.
import '../styles/next.css';
import navData from '../data/nav.json';
import home from '../data/home.json';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'th';
  page: 'home' | 'mission' | 'research' | 'people' | 'projects' | 'publications' | 'contact';
  v1Href: string;         // the same page in v1, for the review switch
  enHref?: string;        // English counterpart (v1 path) when this page has a Thai version
  thHref?: string;        // Thai counterpart (v1 path) when one exists
}
const { title, description, lang = 'en', page, v1Href, enHref, thHref } = Astro.props;
const T = home[lang];
const N = T.next;
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const nx = (p: string) => `/next${p}`;
const enOnly = (n: { enHref: string; thHref: string }) => lang === 'th' && n.thHref === n.enHref;
const href = (n: { enHref: string; thHref: string }) => nx(lang === 'th' ? n.thHref : n.enHref);
const toEn = nx(enHref ?? (lang === 'th' ? '/' : v1Href));
const toTh = nx(thHref ?? '/th/');
const other = lang === 'th' ? home.en : home.th;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang} class="nx">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#05070C" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <script is:inline>
      // The 3D scene runs only with WebGL 2, no reduced-motion request and no Save-Data; otherwise the static frames show.
      (function () {
        var d = document.documentElement, live = typeof WebGL2RenderingContext !== 'undefined';
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) live = false;
          if (navigator.connection && navigator.connection.saveData) live = false;
        } catch (e) {}
        if (live) d.classList.add('nx-live');
      })();
    </script>
  </head>
  <body data-preview={isPreview ? '' : undefined} data-page={page}>
    <a class="nx-skip" href="#main">{N.skip}</a>
    {isPreview && <div class="nx-preview" lang="th">{navData.previewBar}</div>}
    <header class="nx-header" data-header>
      <div class="nx-wrap nx-header-in">
        <a class="nx-brand" href={nx(lang === 'th' ? '/th/' : '/')} aria-label="ARIES Center home">
          <img src="/images/logo-h-white.png" alt="ARIES Smart Infrastructure" width="103" height="34" />
          <span class="nx-brand-div" aria-hidden="true"></span>
          <span class="nx-brand-ku" lang="en">Kasetsart<br />University</span>
        </a>
        <nav class="nx-nav" aria-label="Primary">
          {navData.main.map((n) => (
            <a href={href(n)} class={n.key === page ? 'on' : undefined} aria-current={n.key === page ? 'page' : undefined} hreflang={enOnly(n) ? 'en' : undefined}>
              {n[lang]}{enOnly(n) && <span class="nx-en" lang="en" title="หน้านี้เป็นภาษาอังกฤษ">EN</span>}
            </a>
          ))}
        </nav>
        <div class="nx-lang" role="group" aria-label="Language">
          <a href={toEn} class={lang === 'en' ? 'on' : undefined} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <a href={toTh} class={lang === 'th' ? 'on' : undefined} hreflang="th" lang="th" aria-current={lang === 'th' ? 'true' : undefined}>TH</a>
        </div>
        <details class="nx-menu">
          <summary>{N.menu}</summary>
          <nav class="nx-menu-panel" aria-label="Primary">
            {navData.main.map((n) => (
              <a href={href(n)} aria-current={n.key === page ? 'page' : undefined} hreflang={enOnly(n) ? 'en' : undefined}>
                {n[lang]}{enOnly(n) && <span class="nx-en" lang="en">EN</span>}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="nx-footer">
      <div class="nx-wrap nx-footer-in">
        <div>
          <img src="/images/logo-h-white.png" alt="ARIES" width="133" height="44" />
          <p class="nx-footer-name">{T.title}<br /><span lang={lang === 'th' ? 'en' : 'th'}>{other.title}</span></p>
          <p class="nx-footer-status">{T.status1}</p>
          <p class="nx-footer-addr">{T.status2}</p>
          <small>© {year} {N.copyright}</small>
        </div>
        <nav class="nx-footer-links" aria-label="Footer">
          {navData.main.slice(1).map((n) => (
            <a href={href(n)} hreflang={enOnly(n) ? 'en' : undefined}>{n[lang]}{enOnly(n) && <span class="nx-en" lang="en">EN</span>}</a>
          ))}
          {navData.external.map((x) => <a href={x.href} rel="noopener" lang="en">{x.en}</a>)}
        </nav>
      </div>
    </footer>

    <div class="nx-review" role="group" aria-label="Review tools" lang="th">
      <span>เทียบ</span>
      <a href={v1Href}>v1</a>
      <a class="on" href={nx(v1Href)} aria-current="page">Next</a>
    </div>
  </body>
</html>
