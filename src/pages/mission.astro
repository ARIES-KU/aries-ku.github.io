---
import Base from '../layouts/Base.astro';
import m from '../data/mission.json';
import pages from '../data/pages.json';
const P = pages.mission;
---
<Base title="Mission" description={P.description} page="mission">
  <section class="page inner">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{P.eyebrow}</span>
        <h1>{m.thesis}</h1>
        <p class="lead muted prose">{m.thesisSub}</p>
      </div>

      <section class="block">
        <h2 style="margin-bottom:16px">{P.missionH}</h2>
        <ol class="mission-list">{m.mission.map((t) => <li>{t}</li>)}</ol>
      </section>

      <section class="block">
        <div class="sec-head"><h2>{m.chainH}</h2><p class="muted">{m.chainP}</p></div>
        <ol class="chain">
          {m.layers.map((l, i) => (
            <li class="chain-step">
              <span class="chain-no">{i + 1}</span>
              <div>
                <h3>{l.name}</h3>
                <p>{l.what}</p>
                <p class="muted small"><b>{m.whoL}:</b> {l.who} · <b>{m.producesL}:</b> {l.feeds}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <div class="sec-head"><h2>{P.roadmapH}</h2></div>
        <div class="roadmap">
          {m.roadmap.map((r) => (
            <article class="phase">
              <span class="eyebrow">{r.period}</span>
              <h3>{r.title}</h3>
              <ul class="bullets">{r.items.map((it) => <li>{it}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>

      <section class="block">
        <div class="sec-head"><h2>{P.mapH}</h2></div>
        <div class="tablewrap">
          <table class="map">
            <thead><tr>{P.mapCols.map((c) => <th>{c}</th>)}</tr></thead>
            <tbody>
              {m.projectMap.map((p) => <tr><td>{p.project}</td><td>{p.goal}</td><td>{p.layers.join(' · ')}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p style="margin-top:12px"><a href="/projects/">{P.allProjects}</a></p>
      </section>

      <section class="block">
        <div class="sec-head"><h2>{P.principlesH}</h2></div>
        <div class="pillars">
          {m.principles.map((p) => <article class="pillar"><h3>{p.t}</h3><p class="muted">{p.d}</p></article>)}
        </div>
      </section>

      <section class="block flag" id="work-with-us">
        <div class="head"><div class="sec-head" style="margin-bottom:0"><span class="eyebrow">{P.doorsEyebrow}</span><h2>{P.doorsH}</h2></div></div>
        <div class="doors">
          {m.doors.map((d) => <article class="door"><h3>{d.who}</h3><p>{d.offer}</p></article>)}
        </div>
        <p style="margin-top:20px"><a class="btn primary" href="/contact/">{P.contactBtn}</a></p>
      </section>
    </div>
  </section>
</Base>
