---
import Base from '../layouts/Base.astro';
import research from '../data/research.json';
import problems from '../data/problems.json';
import pubs from '../data/publications.json';

const label = { active: 'Active', next: 'Next phase' } as Record<string, string>;
const byDoi = new Map(pubs.items.filter((p) => p.doi).map((p) => [p.doi!.toLowerCase(), p]));
const paper = (doi: string) => byDoi.get(doi.toLowerCase());
const surnames = pubs.bold.map((s) => s.toLowerCase());
const isMember = (a: string) => surnames.some((s) => a.toLowerCase().includes(s));
---
<Base title="Research" description="The problems ARIES works on, how it approaches them, what the published work found so far, and the four research areas and two groups behind it." page="research">
  <section class="page inner">
    <div class="wrap">
      <div class="th-note only-th" hidden>หน้านี้ยังเป็นภาษาอังกฤษ ฉบับภาษาไทยจะตามมาในระยะถัดไป</div>
      <div class="sec-head">
        <span class="eyebrow">Research</span>
        <h1>The problems we work on</h1>
        <p class="lead muted prose">Each problem below is stated the way an owner agency meets it. Under it: how we approach it, what our published work has found, where the limits are, and the papers to read.</p>
      </div>

      <div class="problems">
        {problems.items.map((p, i) => (
          <article class="problem" id={p.id}>
            <div class="problem-head">
              <span class="pno">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2>{p.question}</h2>
                <p class="muted">{p.context}</p>
              </div>
              <span class={`chip ${p.status === 'active' ? 'ok' : 'next'}`}><i></i>{p.status === 'active' ? 'Published work' : 'In progress'}</span>
            </div>
            <div class="problem-body">
              <div><h3>Approach</h3><p>{p.approach}</p></div>
              <div><h3>What we found</h3><p>{p.findings}</p></div>
              {p.limits && <div><h3>Limits</h3><p class="muted">{p.limits}</p></div>}
              {p.dois.length > 0 && (
                <div class="papers">
                  <h3>Papers</h3>
                  <ul>
                    {p.dois.map((d) => { const w = paper(d); return w
                      ? <li><a href={w.doi} rel="noopener">{w.title}</a> <span class="muted">({w.venue}, {w.year})</span></li>
                      : <li><a href={d} rel="noopener">{d.replace('https://doi.org/', '')}</a></li>; })}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      <section class="block">
        <div class="sec-head"><h2>Four research areas, implemented in phases</h2><p class="muted prose">{research.intro}</p></div>
        <div class="pillars">
          {research.pillars.map((p) => (
            <article class="pillar">
              <div class="row"><h3>{p.name}</h3><span class={`chip ${p.status === 'active' ? 'ok' : 'next'}`}><i></i>{label[p.status]}</span></div>
              <p class="muted">{p.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="block">
        <h2 style="margin-bottom:16px">Research groups</h2>
        <div class="cols">
          {research.groups.map((g) => (
            <article class="pillar">
              <h3>{g.name}</h3>
              <p class="muted">{g.text}</p>
              <p style="font-size:.95rem"><span class="muted">Lead:</span> <b>{g.lead}</b></p>
            </article>
          ))}
        </div>
        <p class="muted" style="margin-top:16px;max-width:66ch">Further groups covering multi-hazard assessment and advanced materials are planned as the center expands.</p>
      </section>

      <section class="block flag" id="bridge-intelligence">
        <div class="head">
          <div class="sec-head" style="margin-bottom:0">
            <span class="eyebrow">Flagship program 2026 to 2028</span>
            <h2>Bridge Intelligence</h2>
          </div>
        </div>
        <div class="cols" style="margin-top:20px">
          <div class="prose"><p>{research.flagship.p1}</p></div>
          <div class="prose"><p>{research.flagship.p2}</p></div>
        </div>
        <div class="pipeline">
          {research.flagship.steps.map((s) => <div class="step"><span class="k">{s.k}</span><h4>{s.h}</h4><p>{s.p}</p></div>)}
        </div>
        <div class="users">Primary users: {research.flagship.users.map((u) => <span>{u}</span>)}</div>
        <p style="margin-top:16px"><a href="/mission/">Why this program, and where it leads →</a></p>
      </section>

      <section class="block">
        <h2>Facilities</h2>
        <p class="muted" style="max-width:66ch;margin-top:8px">{research.facilities.text}</p>
        {research.facilities.equipment.length > 0 && (
          <ul class="bullets" style="margin-top:16px">{research.facilities.equipment.map((e: string) => <li>{e}</li>)}</ul>
        )}
      </section>
    </div>
  </section>
</Base>
