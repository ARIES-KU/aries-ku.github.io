---
import Base from '../layouts/Base.astro';
import research from '../data/research.json';
const label = { active: 'Active', next: 'Next phase' } as Record<string, string>;
---
<Base title="Research" description="Four research areas, two research groups and the Bridge Intelligence flagship program of the ARIES Center, Kasetsart University." page="research">
  <section class="page inner">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Research</span>
        <h1>Four areas, two groups, one flagship</h1>
        <p class="lead muted prose">{research.intro}</p>
      </div>

      <section class="block">
        <h2 style="margin-bottom:16px">Research areas</h2>
        <div class="pillars">
          {research.pillars.map((p) => (
            <article class="pillar">
              <div class="row"><h3>{p.name}</h3><span class={`chip ${p.status === 'active' ? 'ok' : 'next'}`}><i></i>{label[p.status]}</span></div>
              <p class="muted">{p.text}</p>
              <p class="muted" style="font-size:.92rem">{p.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="block">
        <h2 style="margin-bottom:16px">Research groups</h2>
        <div class="cols">
          {research.groups.map((g) => (
            <article class="pillar">
              <h3>{g.name}</h3>
              <p class="muted">{g.text}</p>
              <p style="font-size:.95rem"><span class="muted">Lead:</span> <b>{g.lead}</b></p>
            </article>
          ))}
        </div>
        <p class="muted" style="margin-top:16px;max-width:66ch">Further groups covering multi-hazard assessment and advanced materials are planned as the center expands.</p>
      </section>

      <section class="block flag" id="bridge-intelligence">
        <div class="head">
          <div class="sec-head" style="margin-bottom:0">
            <span class="eyebrow">Flagship program 2026 to 2028</span>
            <h2>Bridge Intelligence</h2>
          </div>
        </div>
        <div class="cols" style="margin-top:20px">
          <div class="prose"><p>{research.flagship.p1}</p></div>
          <div class="prose"><p>{research.flagship.p2}</p></div>
        </div>
        <div class="pipeline">
          {research.flagship.steps.map((s) => <div class="step"><span class="k">{s.k}</span><h4>{s.h}</h4><p>{s.p}</p></div>)}
        </div>
        <div class="users">Primary users: {research.flagship.users.map((u) => <span>{u}</span>)}</div>
      </section>

      <section class="block">
        <h2>Facilities</h2>
        <p class="muted" style="max-width:66ch;margin-top:8px">{research.facilities.text}</p>
        {research.facilities.equipment.length > 0 && (
          <ul class="bullets" style="margin-top:16px">{research.facilities.equipment.map((e: string) => <li>{e}</li>)}</ul>
        )}
      </section>
    </div>
  </section>
</Base>
