---
import Base from '../layouts/Base.astro';
import { faculty, roster, groups, alumni, supportedBy, updated, rosterIsEmpty } from '../lib/people';
import m from '../data/mission.json';
import pages from '../data/pages.json';

const P = pages.people;

const updatedText = new Date(updated + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const filled = roster.filter((g) => g.members.length > 0);
---
<Base title="People" description={P.description} page="people">
  <section class="page inner">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{P.eyebrow}</span>
        <h1>{P.title}</h1>
        <p class="lead muted prose">{P.lead}</p>
      </div>

      <section class="block" style="margin-top:32px">
        <div class="sec-head" style="margin-bottom:16px"><h2>{P.facultyH}</h2></div>
        <div class="cards3">
          {faculty.map((f) => (
            <article class="person">
              <div class="avatar">{f.initials}</div>
              <div><h3>{f.name}</h3><p class="role">{f.role}</p></div>
              <p class="aff">{f.about}</p>
              <div class="links">{f.links.map((l) => <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>)}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="block">
        <div class="sec-head" style="margin-bottom:12px">
          <h2>{P.rosterH}</h2>
          <p class="muted">{P.rosterP}</p>
        </div>
        <div class="roster">
          {rosterIsEmpty
            ? <p class="muted" style="padding:16px 0">{P.rosterEmpty}</p>
            : filled.map((g) => (
              <Fragment>
                <div class="sub">{g.label}</div>
                <ul class="members">
                  {g.members.map((mb) => (
                    <li class={mb.pending ? 'pending' : undefined}>
                      <div>
                        <div class="n">{mb.name} <span class="th-name" lang="th">{mb.name_th}</span>{mb.pending && <span class="pend">{P.pendingTag}</span>}</div>
                        <div class="t">{mb.topic}</div>
                      </div>
                      <span class="grp-tag">{groups[mb.group].short}</span>
                    </li>
                  ))}
                </ul>
              </Fragment>
            ))}
        </div>
      </section>

      <section class="block">
        <details class="alumni">
          <summary>{P.alumniH}</summary>
          {alumni.length
            ? <ul class="members" style="padding:0 20px 12px">{alumni.map((a) => <li><div><div class="n">{a.name}</div><div class="t">{a.note}</div></div><span class="grp-tag">{a.year}</span></li>)}</ul>
            : <p class="muted">{P.alumniEmpty}</p>}
        </details>
      </section>

      {supportedBy.permission && (
        <section class="block">
          <div class="sec-head" style="margin-bottom:8px">
            <h2>{P.supportedH}</h2>
            <p class="muted" style="max-width:66ch">{supportedBy.text}</p>
          </div>
        </section>
      )}

      <section class="block flag" id="collaborate">
        <div class="head"><div class="sec-head" style="margin-bottom:0"><span class="eyebrow">{P.collabEyebrow}</span><h2>{P.collabH}</h2></div></div>
        <div class="doors">
          {m.doors.map((d) => <article class="door"><h3>{d.who}</h3><p>{d.offer}</p></article>)}
        </div>
        <p style="margin-top:20px"><a class="btn primary" href="/contact/">{P.contactBtn}</a> <a class="btn ghost" href="/mission/" style="margin-left:8px">{P.missionBtn}</a></p>
      </section>

      <p class="updated">{P.updatedL} {updatedText}</p>
    </div>
  </section>
</Base>
