---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you asked for does not exist on the ARIES Center website." page="other">
  <section class="page inner">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">404</span>
        <h1>This page does not exist</h1>
        <p class="lead muted prose">The link may be old or mistyped. <a href="/">Go to the home page</a> or <a href="/people/">find a person</a>.</p>
        <p class="muted" lang="th">ไม่พบหน้านี้ <a href="/th/">กลับหน้าแรก</a></p>
      </div>
    </div>
  </section>
</Base>
